# Chat service, run outside docker (the compose stack in services/world sets these itself). Copy to .env (gitignored);
# every variable is in docs/services/chat/configuration.html.
CHAT_HOST=0.0.0.0
CHAT_PORT=7778
CHAT_LINK_PORT=7779
# Shared with every world server's CHAT_LINK_SECRET; 16+ characters
CHAT_LINK_SECRET=change-me-chat-link-secret
CHAT_BIND_TIMEOUT_MS=5000

DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=kast_chat
DB_PASSWORD=change-me-chat-db
DB_NAME=kast_chat

AUTH_JWKS_URL=http://localhost:3100/.well-known/jwks.json
JWT_ISSUER=kast-auth
JWT_AUDIENCE=kast

# TLS: leave both empty for a self-signed dev certificate in TLS_DEV_CERT_DIR
TLS_CERT_FILE=
TLS_KEY_FILE=
TLS_DEV_CERT_DIR=./certs

# Fixed channels, numbered /1, /2, ... in this order; every client joins the first on connect
CHAT_CHANNELS=General,Trade,LFG
CHAT_MAX_BYTES=256
CHAT_RATE_COUNT=5
CHAT_RATE_WINDOW_MS=10000
CHAT_MUTE_MAX_MINUTES=525600

LOG_LEVEL=info
