# World server. Copy to .env (gitignored) and change the secrets. Every variable is in docs/services/world/configuration.html.
REALM_ID=1
WORLD_HOST=0.0.0.0
WORLD_PORT=7777

DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=kast_world
DB_PASSWORD=change-me-world-db
DB_NAME=kast_world
TEST_DB_NAME=kast_world_test

AUTH_JWKS_URL=http://localhost:3100/.well-known/jwks.json
JWT_ISSUER=kast-auth
JWT_AUDIENCE=kast

# TLS: leave both empty for a self-signed dev certificate in TLS_DEV_CERT_DIR
TLS_CERT_FILE=
TLS_KEY_FILE=
TLS_DEV_CERT_DIR=./certs

LOG_LEVEL=info

# Lag simulator, testing only: every message both ways is held SIM_LATENCY_MS +- SIM_JITTER_MS, in order (0 = off)
SIM_LATENCY_MS=0
SIM_JITTER_MS=0

# Lua components/, fsms/ and systems/ (compose uses /app/lua, bind-mounted from ./lua)
LUA_ROOT=./lua
# Game state machines to run, comma-separated names of fsms/ definitions (empty: none)
GAME_STATE_MACHINES=zone_cycle

# Maps: <folder>/map.json each (compose uses /app/maps, bind-mounted from the test project); START_MAP = map id new
# characters start on
MAP_ROOT=../../tests/project/maps
START_MAP=1

# Chat service (docs/services/chat/configuration.html): where clients find it (empty: not announced), the internal link
# (empty host: none) and its shared secret (16+ characters, the chat service's CHAT_LINK_SECRET too); yell range in m
CHAT_YELL_RADIUS=300
CHAT_PUBLIC_HOST=127.0.0.1
CHAT_PUBLIC_PORT=7778
CHAT_LINK_HOST=
CHAT_LINK_PORT=7779
CHAT_LINK_SECRET=change-me-chat-link-secret
CHAT_LINK_CA_FILE=

# Admin port for the admin service (docs/services/world/security.html#admin-port): who is online, kick. Unset or empty
# WORLD_ADMIN_SECRET: off. Secret: 16+ characters, the admin service's too. Never expose the port publicly.
WORLD_ADMIN_HOST=127.0.0.1
WORLD_ADMIN_PORT=7780
WORLD_ADMIN_SECRET=change-me-world-admin-secret

# docker-compose.yml only
MYSQL_ROOT_PASSWORD=change-me-root
AUTH_DB_PASSWORD=change-me-auth-db
WORLD_HOST_PORT=7777
AUTH_HOST_PORT=3100
MYSQL_HOST_PORT=3307
MAILPIT_HOST_PORT=8026
CHAT_HOST_PORT=7778
CHAT_DB_PASSWORD=change-me-chat-db
# Admin app (docs/services/admin/configuration.html): host port (loopback only), its MySQL users' passwords, and the
# first admin, which auth creates pre-verified on start (both or neither)
ADMIN_HOST_PORT=3200
ADMIN_DB_PASSWORD=change-me-admin-db
ADMIN_WORLD_DB_PASSWORD=change-me-world-admin-db
SEED_ADMIN_EMAIL=admin@kast.local
SEED_ADMIN_PASSWORD=change-me-admin-password
