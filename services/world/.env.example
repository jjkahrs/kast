# World server. Copy to .env (gitignored) and change the secrets. Every variable is in README.md.
REALM_ID=1
WORLD_HOST=0.0.0.0
WORLD_PORT=7777

DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=kast_world
DB_PASSWORD=change-me-world-db
DB_NAME=kast_world
TEST_DB_NAME=kast_world_test

AUTH_JWKS_URL=http://localhost:3100/.well-known/jwks.json
JWT_ISSUER=kast-auth
JWT_AUDIENCE=kast

# TLS: leave both empty for a self-signed dev certificate in TLS_DEV_CERT_DIR
TLS_CERT_FILE=
TLS_KEY_FILE=
TLS_DEV_CERT_DIR=./certs

LOG_LEVEL=info

# Lua components/ and systems/ (compose uses /app/lua, bind-mounted from ./lua)
LUA_ROOT=./lua

# docker-compose.yml only
MYSQL_ROOT_PASSWORD=change-me-root
AUTH_DB_PASSWORD=change-me-auth-db
WORLD_HOST_PORT=7777
AUTH_HOST_PORT=3100
MYSQL_HOST_PORT=3307
MAILPIT_HOST_PORT=8026
