# Copy to .env and adjust. npm scripts and tests read this file.
# Values below are for local development only.

# --- HTTP ---
PORT=3200
# Express "trust proxy" setting: false | true | hop count | comma-separated subnets.
TRUST_PROXY=false
# Session cookies are Secure by default. Plain-http development only: false.
COOKIE_SECURE=false
# Built SPA served on the same port; empty = services/admin/web/dist.
STATIC_DIR=

# --- Auth service ---
AUTH_URL=http://127.0.0.1:3100
# Must match auth's JWT_ISSUER / JWT_AUDIENCE; access tokens are verified against auth's JWKS.
JWT_ISSUER=kast-auth
JWT_AUDIENCE=kast

# --- MySQL (one server, two databases, two least-privilege users) ---
DB_HOST=127.0.0.1
DB_PORT=3306
# Owns kast_admin (audit log) only.
ADMIN_DB_USER=kast_admin
ADMIN_DB_PASSWORD=change-me-admin-db
ADMIN_DB_NAME=kast_admin
# SELECT and UPDATE on kast_world.characters only.
WORLD_DB_USER=kast_world_admin
WORLD_DB_PASSWORD=change-me-world-admin-db
WORLD_DB_NAME=kast_world

# --- World admin port (docs/services/world/protocol.html#admin) ---
# Same value as the world servers' WORLD_ADMIN_SECRET; 16+ characters. Never logged or returned.
WORLD_ADMIN_SECRET=change-me-world-admin-secret
# PEM CA for the world servers' TLS certs (the dev cert in the world-certs volume is self-signed); empty = system CAs.
WORLD_ADMIN_CA_FILE=
WORLD_ADMIN_TIMEOUT_MS=3000

# --- Tests (npm test) ---
# Tests use MySQL root to create the test databases and users above (with these names' grants) on first run.
TEST_MYSQL_ROOT_PASSWORD=change-me-root
TEST_ADMIN_DB_NAME=kast_admin_test
TEST_WORLD_DB_NAME=kast_world_test
# The auth service runs in-process from ../auth with ../auth/.env, on its test database.
