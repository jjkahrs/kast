/* Starter MMO screens. One sheet for every .rml here; colours are the Kast editor palette:
   #ffaa00 buttons and headers, #ffcc00 highlight, #ff9900 pressed, #000000 background, #313131 cards,
   #454545 text fields, #818181 text field highlight. */
body {
    width: 100%;
    height: 100%;
    font-family: Roboto;
    font-size: 18px;
    color: #f0f0f0;
}

div, p {
    display: block;
}

.screen {
    width: 100%;
    height: 100%;
    background-color: #000000;
}

.card {
    width: 440px;
    margin: 50px auto;
    padding: 24px;
    background-color: #313131;
    border-radius: 8px;
}

.header {
    margin: -24px -24px 18px -24px;
    padding: 12px 24px;
    background-color: #ffaa00;
    border-radius: 8px 8px 0 0;
    color: #000000;
    font-size: 28px;
}

.label {
    margin-top: 10px;
    font-size: 15px;
    color: #c8c8c8;
}

input {
    display: block;
    box-sizing: border-box;
    width: 100%;
    height: 34px;
    margin-top: 4px;
    padding: 6px 8px;
    background-color: #454545;
    border-radius: 4px;
    color: #ffffff;
}

input:hover, input:focus {
    background-color: #818181;
}

button {
    display: block;
    width: 100%;
    margin-top: 12px;
    padding: 9px 0;
    background-color: #ffaa00;
    border-radius: 5px;
    color: #000000;
    text-align: center;
}

button:hover {
    background-color: #ffcc00;
}

button:active {
    background-color: #ff9900;
}

button.secondary {
    background-color: #454545;
    color: #f0f0f0;
}

button.secondary:hover {
    background-color: #818181;
}

.status {
    margin-top: 14px;
    min-height: 20px;
    color: #ffcc00;
}

.hint {
    margin-top: 6px;
    font-size: 14px;
    color: #a0a0a0;
}

/* In-world overlays (world.scene): small and in the corners, so the world stays visible. */
#hud {
    position: absolute;
    left: 12px;
    top: 12px;
    width: 180px;
    font-size: 15px;
    background-color: #313131dd;
    border-radius: 6px;
}

#hud_name {
    padding: 6px 12px;
    background-color: #ffaa00;
    border-radius: 6px 6px 0 0;
    color: #000000;
    font-size: 18px;
}

#hud .stat {
    padding: 3px 12px;
}

#hud_map {
    padding-bottom: 8px;
}

#chat {
    position: absolute;
    left: 12px;
    bottom: 12px;
    width: 360px;
    padding: 8px 10px;
    font-size: 14px;
    background-color: #313131dd;
    border-radius: 6px;
}

#chat_log {
    height: 120px;
}

#chat_row {
    margin-top: 6px;
}

#chat_input {
    display: inline-block;
    width: 270px;
    height: 28px;
    margin-top: 0;
    padding: 4px 6px;
}

#chat_send {
    display: inline-block;
    width: 64px;
    margin: 0 0 0 6px;
    padding: 5px 0;
}
