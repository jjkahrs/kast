/* Starter MMO screens. One sheet for every .rml here; colours are the Kast editor palette:
   #ffaa00 buttons and headers, #ffcc00 highlight, #ff9900 pressed, #000000 background, #313131 cards,
   #454545 text fields, #818181 text field highlight. */
body {
    width: 100%;
    height: 100%;
    font-family: Roboto;
    font-size: 18px;
    color: #f0f0f0;
    pointer-events: none; /* the world scene stacks full-screen documents: only their panels take the mouse */
}

.screen, .card, .window, #hud, #target_frame, #chat, #action_bar {
    pointer-events: auto;
}

div, p {
    display: block;
}

.screen {
    width: 100%;
    height: 100%;
    background-color: #000000;
}

.card {
    width: 440px;
    margin: 50px auto;
    padding: 24px;
    background-color: #313131;
    border-radius: 8px;
}

.header {
    margin: -24px -24px 18px -24px;
    padding: 12px 24px;
    background-color: #ffaa00;
    border-radius: 8px 8px 0 0;
    color: #000000;
    font-size: 28px;
}

.label {
    margin-top: 10px;
    font-size: 15px;
    color: #c8c8c8;
}

input {
    display: block;
    box-sizing: border-box;
    width: 100%;
    height: 34px;
    margin-top: 4px;
    padding: 6px 8px;
    background-color: #454545;
    border-radius: 4px;
    color: #ffffff;
}

input:hover, input:focus {
    background-color: #818181;
}

button {
    display: block;
    width: 100%;
    margin-top: 12px;
    padding: 9px 0;
    background-color: #ffaa00;
    border-radius: 5px;
    color: #000000;
    text-align: center;
}

button:hover {
    background-color: #ffcc00;
}

button:active {
    background-color: #ff9900;
}

button.secondary {
    background-color: #454545;
    color: #f0f0f0;
}

button.secondary:hover {
    background-color: #818181;
}

/* Characters screen (scripts/characters.lua): the class toggles; the picked one in the highlight colour. */
button.class_button {
    display: inline-block;
    width: 92px;
    margin: 6px 2px 0 2px;
    background-color: #454545;
    color: #f0f0f0;
}

button.class_button:hover {
    background-color: #818181;
}

button.class_button.selected {
    background-color: #ffcc00;
    color: #000000;
}

.status {
    margin-top: 14px;
    min-height: 20px;
    color: #ffcc00;
}

.hint {
    margin-top: 6px;
    font-size: 14px;
    color: #a0a0a0;
}

/* In-world overlays (world.scene): small and in the corners, so the world stays visible. */
#hud {
    position: absolute;
    left: 12px;
    top: 12px;
    width: 230px;
    font-size: 15px;
    background-color: #313131dd;
    border-radius: 6px;
}

#hud_header {
    padding: 6px 12px;
    background-color: #ffaa00;
    border-radius: 6px 6px 0 0;
    color: #000000;
    font-size: 18px;
}

#hud_class {
    margin-left: 8px;
    font-size: 15px;
}

#hud .stat {
    padding: 3px 12px;
}

#hud_map {
    padding-bottom: 8px;
}

/* The selected NPC (scripts/combat.lua, scripts/hud.lua): top centre; hud.lua hides it without a target. */
#target_frame {
    position: absolute;
    left: 50%;
    top: 12px;
    width: 200px;
    margin-left: -100px;
    font-size: 15px;
    background-color: #313131dd;
    border-radius: 6px;
}

#target_name {
    padding: 4px 12px;
    background-color: #ffaa00;
    border-radius: 6px 6px 0 0;
    color: #000000;
    font-size: 17px;
}

#target_health {
    padding: 3px 12px 6px 12px;
}

/* The class's powers (scripts/powers.lua): bottom centre; a button greys while it cools down. */
#action_bar {
    position: absolute;
    left: 50%;
    bottom: 12px;
    width: 432px;
    margin-left: -216px;
    padding: 4px;
    background-color: #313131dd;
    border-radius: 6px;
}

button.power {
    display: inline-block;
    width: 136px;
    margin: 0 2px;
    padding: 10px 0;
    font-size: 15px;
}

button.power.cooling {
    background-color: #454545;
    color: #a0a0a0;
}

/* Narrow views (the editor's Game view): centred, the bar would cover the chat box; start it right of the chat. */
@media (max-width: 1100px) {
    #action_bar {
        left: 384px;
        margin-left: 0;
    }
}

#chat {
    position: absolute;
    left: 12px;
    bottom: 12px;
    width: 360px;
    padding: 8px 10px;
    font-size: 14px;
    background-color: #313131dd;
    border-radius: 6px;
}

#chat_log {
    height: 120px;
}

#chat_row {
    margin-top: 6px;
}

#chat_input {
    display: inline-block;
    width: 270px;
    height: 28px;
    margin-top: 0;
    padding: 4px 6px;
}

#chat_send {
    display: inline-block;
    width: 64px;
    margin: 0 0 0 6px;
    padding: 5px 0;
}

/* Bag and loot windows (ui/bag.rml, ui/loot.rml; scripts/bag.lua, scripts/loot.lua). Item quality colours are WoW's:
   poor #9d9d9d, common #ffffff, uncommon #1eff00, for slot borders (.slot.q_*) and names (.q_*). */
.window {
    position: absolute;
    padding: 0 8px 8px 8px;
    font-size: 14px;
    background-color: #313131ee;
    border-radius: 6px;
}

.window_title {
    margin: 0 -8px 8px -8px;
    padding: 5px 10px;
    background-color: #ffaa00;
    border-radius: 6px 6px 0 0;
    color: #000000;
    font-size: 16px;
}

#bag {
    right: 12px;
    bottom: 12px;
    width: 232px;
}

#bag_grid {
    width: 232px;
}

.slot {
    display: inline-block;
    position: relative;
    width: 50px;
    height: 50px;
    margin: 2px;
    background-color: #000000;
    border: 2px #454545;
    border-radius: 4px;
    drag: clone;
}

.slot.empty {
    drag: none;
}

.slot:hover {
    background-color: #454545;
}

.slot.q_poor { border-color: #9d9d9d; }
.slot.q_common { border-color: #ffffff; }
.slot.q_uncommon { border-color: #1eff00; }

.icon {
    display: inline-block;
    width: 46px;
    height: 46px;
}

.count {
    position: absolute;
    right: 3px;
    bottom: 1px;
    font-size: 14px;
    color: #ffffff;
    font-effect: outline(1px #000000);
}

#bag_tooltip {
    position: absolute;
    right: 256px;
    bottom: 12px;
    width: 220px;
    padding: 6px 10px;
    font-size: 14px;
    background-color: #000000ee;
    border: 1px #818181;
    border-radius: 4px;
}

#tooltip_name {
    font-size: 16px;
}

.tooltip_line {
    margin-top: 2px;
}

#tooltip_description {
    color: #ffcc00;
}

.q_poor { color: #9d9d9d; }
.q_common { color: #ffffff; }
.q_uncommon { color: #1eff00; }

#destroy_dialog {
    left: 50%;
    top: 35%;
    width: 280px;
    margin-left: -140px;
}

#destroy_text {
    margin: 4px 0 6px 0;
}

#loot {
    left: 12px;
    top: 190px;
    width: 230px;
}

button.loot_entry {
    display: block;
    height: 46px;
    margin-top: 4px;
    padding: 0;
    background-color: #000000;
    color: #f0f0f0;
    text-align: left;
    border-radius: 4px;
}

button.loot_entry:hover {
    background-color: #454545;
}

.loot_entry .icon {
    width: 42px;
    height: 42px;
    margin: 2px;
}

.loot_name {
    display: inline-block;
    width: 170px;
    margin-left: 6px;
    vertical-align: middle;
}

.icon.coin {
    decorator: image(../textures/icons/coin.png);
}

/* Character window (ui/character.rml, scripts/character.lua): a WoW-style paper doll left of the bag. The equipment
   slots are .slot (the bag's look, drag and quality borders), placed around the silhouette: Head, Chest, Legs on the
   left, Hands and Feet on the right, Main Hand and Off Hand below. An empty slot shows its faint name. */
#character {
    right: 256px;
    top: 84px;
    width: 284px;
}

#character_class {
    margin-left: 8px;
    font-size: 14px;
}

#paperdoll {
    position: relative;
    width: 284px;
    height: 236px;
}

#silhouette {
    position: absolute;
    left: 98px;
    top: 0;
    width: 87px;
    height: 174px;
}

.equip {
    position: absolute;
    margin: 0;
}

#equip_1 { left: 0; top: 0; }
#equip_2 { left: 0; top: 60px; }
#equip_3 { left: 0; top: 120px; }
#equip_5 { left: 230px; top: 0; }
#equip_4 { left: 230px; top: 60px; }
#equip_6 { left: 84px; top: 182px; }
#equip_7 { left: 146px; top: 182px; }

.equip_label {
    position: absolute;
    left: 0;
    top: 10px;
    width: 50px;
    font-size: 11px;
    color: #818181;
    text-align: center;
}

#character_stats {
    margin-top: 4px;
    padding: 4px 8px;
    background-color: #000000;
    border-radius: 4px;
}

.stat_line {
    padding: 1px 0;
}

#gear_tooltip {
    position: absolute;
    right: 568px;
    top: 84px;
    width: 220px;
    padding: 6px 10px;
    font-size: 14px;
    background-color: #000000ee;
    border: 1px #818181;
    border-radius: 4px;
}

#gear_tooltip_name {
    font-size: 16px;
}

#gear_tooltip_description {
    color: #ffcc00;
}

.gear_stats {
    color: #1eff00;
}
