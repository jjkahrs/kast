<rml>
    <head>
        <title>Quest Log</title>
        <link type="text/rcss" href="starter.rcss" data-kast-id="15ecd441-7e6e-4395-bce7-288118db1e7c"/>
    </head>
    <body>
        <!-- scripts/quest_log.lua: L opens and closes the quest log. Each active quest (the replicated Quests, titles
             and objectives from the server's quest.log) with its objectives' progress; the chosen one's text and
             rewards below, and Abandon. -->
        <div id="quest_log" class="window">
            <p class="window_title">Quest Log <span id="qlog_count"></span></p>
            <p id="qlog_empty" class="quest_text">No quests. Look for a yellow ! over a friendly NPC.</p>
            <!-- model "quest_log", key "rows": {title, progress, selected} each; row ids qlog_row_0, qlog_row_1, ... -->
            <div id="qlog_list" data-model="quest_log">
                <button class="qlog_row" data-for="row : rows" data-attr-id="'qlog_row_' + it_index" data-class-selected="row.selected" data-event="quest.log_select"><p class="qlog_row_title">{{row.title}}</p><p class="qlog_row_progress">{{row.progress}}</p></button>
            </div>
            <div id="qlog_detail">
                <p id="qlog_title" class="quest_title">-</p>
                <p id="qlog_text" class="quest_text">-</p>
                <p id="qlog_rewards_heading" class="quest_heading">Rewards</p>
                <div id="qlog_reward_gold" class="quest_reward"><div class="icon coin"></div><p id="qlog_reward_gold_name" class="loot_name">-</p></div>
            <div id="qlog_reward_1" class="quest_reward"><div id="qlog_reward_1_icon" class="icon"></div><p id="qlog_reward_1_name" class="loot_name">-</p></div>
            <div id="qlog_reward_2" class="quest_reward"><div id="qlog_reward_2_icon" class="icon"></div><p id="qlog_reward_2_name" class="loot_name">-</p></div>
            <div id="qlog_reward_3" class="quest_reward"><div id="qlog_reward_3_icon" class="icon"></div><p id="qlog_reward_3_name" class="loot_name">-</p></div>
                <button id="qlog_abandon" class="secondary" data-event="quest.log_abandon">Abandon</button>
            </div>
        </div>
    </body>
</rml>
