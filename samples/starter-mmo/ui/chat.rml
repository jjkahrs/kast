<rml>
    <head>
        <title>Chat</title>
        <link type="text/rcss" href="starter.rcss" data-kast-id="15ecd441-7e6e-4395-bce7-288118db1e7c"/>
    </head>
    <body>
        <div id="chat">
            <!-- scripts/chat.lua's lines (model "chat", key "lines": {text, kind} each), oldest first; the newest that fit
                 show -->
            <div id="chat_log" data-model="chat">
                <p class="chat_line" data-for="line : lines" data-attr-class="'chat_line chat_' + line.kind">{{line.text}}</p>
            </div>
            <div id="chat_row">
                <!-- tab-index inline: Tab is the target key (scripts/combat.lua); RmlUi's own inline tab-index on inputs
                     beats a style sheet's -->
                <input type="text" id="chat_input" maxlength="200" style="tab-index: none"/>
                <button id="chat_send" data-event="chat.send">Send</button>
            </div>
        </div>
    </body>
</rml>
