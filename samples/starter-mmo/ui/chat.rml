<rml>
    <head>
        <title>Chat</title>
        <link type="text/rcss" href="starter.rcss"/>
    </head>
    <body>
        <div id="chat">
            <!-- scripts/chat.lua fills the lines (text and a chat_* class each), oldest first -->
            <div id="chat_log">
                <p id="chat_line_1" class="chat_line"></p>
                <p id="chat_line_2" class="chat_line"></p>
                <p id="chat_line_3" class="chat_line"></p>
                <p id="chat_line_4" class="chat_line"></p>
                <p id="chat_line_5" class="chat_line"></p>
                <p id="chat_line_6" class="chat_line"></p>
                <p id="chat_line_7" class="chat_line"></p>
                <p id="chat_line_8" class="chat_line"></p>
                <p id="chat_line_9" class="chat_line"></p>
                <p id="chat_line_10" class="chat_line"></p>
            </div>
            <div id="chat_row">
                <!-- tab-index inline: Tab is the target key (scripts/combat.lua); RmlUi's own inline tab-index on inputs
                     beats a style sheet's -->
                <input type="text" id="chat_input" maxlength="200" style="tab-index: none"/>
                <button id="chat_send" data-event="chat.send">Send</button>
            </div>
        </div>
    </body>
</rml>
