<rml>
    <head>
        <title>Chat</title>
        <link type="text/rcss" href="starter.rcss"/>
    </head>
    <body>
        <div id="chat">
            <p id="chat_log"></p>
            <div id="chat_row">
                <!-- tab-index inline: Tab is the target key (scripts/combat.lua); RmlUi's own inline tab-index on inputs
                     beats a style sheet's -->
                <input type="text" id="chat_input" maxlength="200" style="tab-index: none"/>
                <button id="chat_send" data-event="chat.send">Send</button>
            </div>
        </div>
    </body>
</rml>
