<rml>
    <head>
        <title>Realms</title>
        <link type="text/rcss" href="starter.rcss" data-kast-id="15ecd441-7e6e-4395-bce7-288118db1e7c"/>
    </head>
    <body>
        <div id="screen" class="screen">
            <div id="realms_card" class="card">
                <p id="title" class="header">Choose a realm</p>
                <p id="account" class="hint"></p>
                <button id="realm_1" data-event="realms.pick"></button>
                <button id="realm_2" data-event="realms.pick"></button>
                <button id="realm_3" data-event="realms.pick"></button>
                <button id="realm_4" data-event="realms.pick"></button>
                <button id="logout_button" class="secondary" data-event="realms.logout">Log out</button>
                <p id="realms_status" class="status"></p>
            </div>
        </div>
    </body>
</rml>
