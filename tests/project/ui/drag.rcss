body {
    width: 100%;
    height: 100%;
    font-family: Roboto;
    font-size: 18px;
    color: #f0f0f0;
}

div, p {
    display: block;
}

.box {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 80px;
    height: 80px;
    margin-left: -40px;
    margin-top: -40px;
    background-color: #ffaa00;
    decorator: image(../textures/checker.png);
    drag: clone;
}

#source_icon {
    position: absolute;
    left: 24px;
    top: 4px;
    width: 32px;
    height: 32px;
}

#target_icon {
    width: 64px;
    height: 64px;
}

.label {
    position: relative;
    padding-top: 28px;
    text-align: center;
    color: #000000;
}

.target {
    position: absolute;
    left: 60%;
    right: 2%;
    top: 20%;
    bottom: 20%;
    background-color: #313131;
    border: 3px #818181;
}

.target.lit {
    border-color: #1eff00;
}
