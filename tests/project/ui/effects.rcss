body {
    width: 100%;
    height: 100%;
    font-family: Roboto;
    font-size: 20px;
    color: #ffffff;
    background-color: #000000;
}

div {
    display: block;
}

.box {
    position: absolute;
    width: 120px;
    height: 60px;
    text-align: center;
    line-height: 60px;
}

#glow { left: 40px; top: 40px; background-color: #313131; box-shadow: 0 0 12px 4px #ffaa00; }
#blur { left: 220px; top: 40px; background-color: #3a6fb0; filter: blur(4px); }
#gray { left: 400px; top: 40px; background-color: #ff0000; filter: grayscale(1); }
#linear { left: 580px; top: 40px; decorator: linear-gradient(90deg, #ff0000, #0000ff); }

#drop { left: 40px; top: 160px; background-color: #3a6fb0; filter: drop-shadow(#00ff00 8px 8px 4px); }
#stripes {
    position: absolute;
    left: 200px;
    top: 140px;
    width: 160px;
    height: 100px;
    decorator: repeating-linear-gradient(90deg, #ff0000 0px, #ff0000 10px, #00ff00 10px, #00ff00 20px);
}
#backdrop { left: 220px; top: 160px; background-color: #ffffff20; backdrop-filter: blur(6px); }
#radial { left: 400px; top: 160px; decorator: radial-gradient(circle, #ffff00, #0000ff); }
#conic { left: 580px; top: 160px; decorator: conic-gradient(#ff0000, #00ff00, #0000ff, #ff0000); }

#sepia { left: 40px; top: 280px; background-color: #3a6fb0; filter: sepia(1); }
#invert { left: 220px; top: 280px; background-color: #3a6fb0; filter: invert(1); }
#hue { left: 400px; top: 280px; background-color: #ff0000; filter: hue-rotate(120deg); }
#bright { left: 580px; top: 280px; background-color: #3a6fb0; filter: brightness(1.5); }

#contrast { left: 40px; top: 400px; background-color: #3a6fb0; filter: contrast(2); }
#saturate { left: 220px; top: 400px; background-color: #3a6fb0; filter: saturate(0); }
#opacity { left: 400px; top: 400px; background-color: #3a6fb0; filter: opacity(0.5); }
#rradial {
    left: 580px;
    top: 400px;
    width: 60px;
    decorator: repeating-radial-gradient(circle, #ff0000 0px, #ff0000 8px, #0000ff 8px, #0000ff 16px);
}
#rconic {
    left: 660px;
    top: 400px;
    width: 60px;
    decorator: repeating-conic-gradient(#ff0000 0deg, #ff0000 45deg, #00ff00 45deg, #00ff00 90deg);
}
