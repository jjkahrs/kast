/* Layout only: the lists in lists.rml are styled by the engine's default style. */
body {
    width: 100%;
    height: 100%;
    font-family: Roboto;
    font-size: 16px;
    color: #f0f0f0;
}

div, p {
    display: block;
}

.panel {
    position: absolute;
    top: 6%;
    padding: 12px;
    background-color: #000000cc;
}

#static_panel {
    left: 6%;
}

#virtual_panel {
    left: 40%;
}

.heading {
    margin: 6px 0;
    font-size: 20px;
    color: #ffcc00;
}

#big {
    width: 320px;
    height: 480px;
}
