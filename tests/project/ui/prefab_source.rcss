body {
    width: 100%;
    height: 100%;
    font-family: Roboto;
    font-size: 18px;
    color: #ffffff;
}

div, p {
    display: block;
}

.card {
    width: 300px;
    margin: 40px;
    padding: 16px;
    background-color: #313131;
    border: 2px #ffaa00;
}

.card-title {
    margin-bottom: 10px;
}

button {
    display: inline-block;
    padding: 6px 14px;
    background-color: #ffaa00;
    color: #000000;
}
