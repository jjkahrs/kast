body {
    width: 100%;
    height: 100%;
    font-family: Roboto;
    font-size: 16px;
    color: #000000;
}

#all_box {
    display: block;
    position: absolute;
    left: 400px;
    top: 20px;
    width: 160px;
    height: 80px;
    background-color: #20c040;
}

#all_field {
    position: absolute;
    left: 400px;
    top: 300px;
    width: 120px;
    background-color: #454545;
    color: #ffffff;
}
