body {
    width: 100%;
    height: 100%;
    font-family: Roboto;
    font-size: 16px;
    background-color: #000000;
    color: #000000;
}

div {
    display: block;
    position: absolute;
}

#dp_box {
    left: 20dp;
    top: 20dp;
    width: 160dp;
    height: 80dp;
    background-color: #ffaa00;
    font-size: 16dp;
}

#px_box {
    left: 20px;
    top: 200px;
    width: 160px;
    height: 80px;
    background-color: #2060ff;
}

#dp_field {
    position: absolute;
    left: 220px;
    top: 300px;
    width: 120px;
    background-color: #454545;
    color: #ffffff;
}
