/* Layout only: the widgets in widgets.rml are styled by the engine's default widget style. */
body {
    width: 100%;
    height: 100%;
    font-family: Roboto;
    font-size: 16px;
    color: #f0f0f0;
}

div, p {
    display: block;
}

#widgets_panel, #bound_panel {
    position: absolute;
    top: 8%;
    width: 36%;
    padding: 12px;
    background-color: #313131;
}

#widgets_panel {
    left: 8%;
}

#bound_panel {
    right: 8%;
}

.heading {
    margin-bottom: 10px;
    font-size: 20px;
    color: #ffcc00;
}

.row {
    height: 34px;
}

#made_row {
    height: auto;
}

.name {
    display: inline-block;
    width: 120px;
}
