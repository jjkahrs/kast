<rml>
    <head>
        <title>Main Menu</title>
        <link type="text/rcss" href="main_menu.rcss"/>
    </head>
    <body>
        <!-- The game's main menu: Start and Quit publish menu.start / menu.quit. -->
        <div id="menu" class="panel">
            <p id="title" class="title">Kast Quest</p>
            <p id="subtitle">An adventure <span class="accent">awaits</span></p>
            <div id="buttons" class="buttons">
                <button id="start_button" data-event="menu.start" title="Begin a new game">Start</button>
                <button id="quit_button" data-event="menu.quit">Quit</button>
            </div>
        </div>
    </body>
</rml>
