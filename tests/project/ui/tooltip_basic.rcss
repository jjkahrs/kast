/* Layout only: the tooltips wear the engine's default style (kGuiWidgetStyle's #kast-tooltip). */
body {
    width: 100%;
    height: 100%;
    font-family: Roboto;
    font-size: 16px;
    color: #f0f0f0;
}

div {
    display: block;
}

.slot {
    position: absolute;
    width: 120px;
    height: 48px;
    background-color: #205080;
}

#bag {
    left: 40px;
    top: 40px;
    drag: drag; /* the self check drags it: no tooltip during a drag */
}

#bag_icon {
    margin: 8px;
    width: 32px;
    height: 32px;
    background-color: #80c040;
}

#rich {
    left: 200px;
    top: 40px;
}

#blank {
    left: 360px;
    top: 40px;
    drag: clone; /* the self check drags it over #rich: no tooltip during a drag */
}

#corner {
    right: 0px;
    bottom: 0px;
}
