/* Layout only: the link colours are the engine's default style (kGuiWidgetStyle). */
body {
    width: 100%;
    height: 100%;
    font-family: Roboto;
    font-size: 16px;
    color: #f0f0f0;
}

div, p {
    display: block;
}

.panel {
    position: absolute;
    left: 2%;
    top: 4%;
    width: 44%;
    padding: 10px;
    background-color: #313131;
}

.panel p {
    margin-bottom: 6px;
}

.center {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 240px;
    height: 40px;
    margin-left: -120px;
    margin-top: -20px;
    line-height: 40px;
    text-align: center;
    font-size: 28px;
    background-color: #000000;
}
