body {
    width: 100%;
    height: 100%;
    font-family: Roboto;
    font-size: 20px;
    color: #f0f0f0;
}

div, p {
    display: block;
}

.panel {
    width: 420px;
    margin: 60px auto;
    padding: 24px;
    background-color: #1b2333dd;
    border: 3px #e0a030;
    border-radius: 10px;
    text-align: center;
}

.title {
    font-size: 40px;
    color: #ffd060;
    margin-bottom: 8px;
}

#subtitle {
    margin-bottom: 24px;
}

.accent {
    color: #7fd0ff;
}

button {
    display: block;
    width: 200px;
    margin: 10px auto;
    padding: 10px 0;
    background-color: #3a6fb0;
    border-radius: 6px;
}

button:hover {
    background-color: #4f89d0;
}

button:active {
    background-color: #2a5590;
}
