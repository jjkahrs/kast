<rml>
    <head>
        <title>Prefab Source</title>
        <link type="text/rcss" href="prefab_source.rcss" data-kast-id="82c4d45c-1c85-4d18-88fc-7d0bafee3101"/>
    </head>
    <body>
        <!-- Create GUI Prefab from #card (ctest gui_builder_prefab_create*): a Panel holding a Text and a Button. -->
        <div id="card" class="card">
            <p id="card_title" class="card-title">Card title</p>
            <button id="card_button" data-event="card.clicked">Open</button>
        </div>
    </body>
</rml>
