# samples/starter-mmo's built game.pak (ctest starter_mmo_build) holds no server-only quest definitions: no entry from a
# .server/ dot-folder (they never ship) and no quest text, while the client's own quest scripts are there. Reads the
# pak's table of contents ("KPAK", u32 version, u32 count, then per entry: u32 name length, name, u64 offset, u64 size;
# little-endian, editor/build.cpp). Comments that merely mention ".server/" in shipped files don't count.
# Usage: cmake -DPAK=<game.pak> -P starter_mmo_pak_check.cmake
function(read_u32 offset out)
  file(READ "${PAK}" hex OFFSET ${offset} LIMIT 4 HEX)
  string(SUBSTRING "${hex}" 6 2 b3)
  string(SUBSTRING "${hex}" 4 2 b2)
  string(SUBSTRING "${hex}" 2 2 b1)
  string(SUBSTRING "${hex}" 0 2 b0)
  math(EXPR value "0x${b3}${b2}${b1}${b0}")
  set(${out} ${value} PARENT_SCOPE)
endfunction()

file(READ "${PAK}" magic LIMIT 4)
if(NOT magic STREQUAL "KPAK")
  message(FATAL_ERROR "${PAK} is not a Kast pak")
endif()
read_u32(8 count)
set(at 12)
set(server_only "")
set(has_quest_script FALSE)
foreach(i RANGE 1 ${count})
  read_u32(${at} length)
  math(EXPR at "${at} + 4")
  file(READ "${PAK}" name OFFSET ${at} LIMIT ${length})
  string(STRIP "${name}" name) # file(READ ... LIMIT) may add a newline
  math(EXPR at "${at} + ${length} + 16")
  if(name MATCHES "(^|/)\\.server/")
    list(APPEND server_only "${name}")
  elseif(name STREQUAL "scripts/quest.lua")
    set(has_quest_script TRUE)
  endif()
endforeach()
if(server_only)
  message(FATAL_ERROR "game.pak holds server-only entries: ${server_only}")
endif()
file(STRINGS "${PAK}" quest_text REGEX "Bats from the Cavern east of here|fine poultice")
if(quest_text)
  message(FATAL_ERROR "game.pak holds quest text: ${quest_text}")
endif()
if(NOT has_quest_script)
  message(FATAL_ERROR "game.pak has no scripts/quest.lua entry (is this the starter-mmo build?)")
endif()
message(STATUS "OK: ${count} entries, none from a .server/ folder, no quest text; scripts/quest.lua is there")
