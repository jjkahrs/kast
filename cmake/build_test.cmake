# Headless Build: kast_editor [--project <dir>] --build <out> must exit with EXPECT (0 or 1).
# On success <out> must hold EXE, game.pak and the player's DLLs, game.pak must leave out the project's .kast/ folder,
# and project.kast must be unchanged. On failure <out> (created empty first) must get no exe and no game.pak.
# EXPECT_OUTPUT: text the editor's output must contain.
# Usage: cmake -DEDITOR=<exe> -DOUT=<dir> -DEXPECT=0|1 [-DPROJECT=<dir>] [-DEXE=<name.exe>] [-DEXPECT_OUTPUT=<text>]
#              -P build_test.cmake
file(REMOVE_RECURSE "${OUT}")
set(args)
if(DEFINED PROJECT)
  set(args --project "${PROJECT}")
  file(SHA256 "${PROJECT}/project.kast" project_before)
endif()
if(EXPECT EQUAL 1)
  file(MAKE_DIRECTORY "${OUT}")
endif()
execute_process(COMMAND "${EDITOR}" ${args} --build "${OUT}" RESULT_VARIABLE result OUTPUT_VARIABLE output
                ERROR_VARIABLE output)
message("${output}")
if(DEFINED EXPECT_OUTPUT)
  string(FIND "${output}" "${EXPECT_OUTPUT}" found)
  if(found EQUAL -1)
    message(FATAL_ERROR "Output lacks '${EXPECT_OUTPUT}'")
  endif()
endif()
if(NOT result EQUAL EXPECT)
  message(FATAL_ERROR "kast_editor --build exited with ${result}, expected ${EXPECT}")
endif()
if(EXPECT EQUAL 1)
  file(GLOB written "${OUT}/*.exe" "${OUT}/game.pak")
  if(written)
    message(FATAL_ERROR "A failed build wrote: ${written}")
  endif()
  message(STATUS "OK: exit 1, nothing written to ${OUT}")
  return()
endif()
foreach(file "${EXE}" game.pak SDL3.dll lua51.dll rmlui.dll)
  if(NOT EXISTS "${OUT}/${file}")
    message(FATAL_ERROR "Missing build output: ${OUT}/${file}")
  endif()
endforeach()
# Index paths are stored as plain text, so they show up as strings in the binary.
file(STRINGS "${OUT}/game.pak" listed REGEX "project\\.kast")
if(NOT listed)
  message(FATAL_ERROR "game.pak has no project.kast entry")
endif()
# An entry's path follows its u32 length, whose high bytes are 0, so a .kast/ path starts a string; the anchor skips
# "project.kast" followed by an index offset byte that happens to be '/'.
file(STRINGS "${OUT}/game.pak" dot_kast REGEX "^\\.kast/")
if(dot_kast)
  message(FATAL_ERROR "game.pak includes the .kast/ folder: ${dot_kast}")
endif()
file(SHA256 "${PROJECT}/project.kast" project_after)
if(NOT project_before STREQUAL project_after)
  message(FATAL_ERROR "--build changed ${PROJECT}/project.kast")
endif()
message(STATUS "OK: exit 0, ${OUT} holds ${EXE}, game.pak (no .kast/) and the DLLs")
