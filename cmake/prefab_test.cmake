# Runs the editor headless on a fresh copy of a project with prefab steps (--create-prefab, --drop-prefab, --prefab-apply,
# ...), saving the scene, then checks the files it left. Each check is "<file>|<regex>", the file relative to the copy
# and read with all whitespace removed (so `"parent":3` matches however the JSON is indented).
# Usage: cmake -DEDITOR=<exe> -DPROJECT=<dir> -DWORK_DIR=<dir> -DSCENE=<scene in the project> -DARGS="<editor flags>"
#              [-DCAMERA=<editor camera JSON>] [-DEXPECT=<check;...>] [-DFORBID=<check;...>]
#              [-DLAST_Y=zero|above:<number>] [-DLAST_FAR=<meters>] [-DEXPECT_FAIL=1] -P prefab_test.cmake
# The editor saves to <copy>/out.scene. CAMERA replaces the scene's editor camera first (--drop-prefab-view aims with
# it). LAST_Y / LAST_FAR check the position of the last root instance in out.scene: y is 0 / above the number, and x
# or z is farther than LAST_FAR from the origin. EXPECT_FAIL: a step must be refused as a prefab cycle (exit 1).
file(REMOVE_RECURSE "${WORK_DIR}")
file(COPY "${PROJECT}/" DESTINATION "${WORK_DIR}")
if(DEFINED CAMERA)
  file(READ "${WORK_DIR}/${SCENE}" scene)
  string(JSON scene SET "${scene}" editor camera "${CAMERA}")
  file(WRITE "${WORK_DIR}/${SCENE}" "${scene}")
endif()
separate_arguments(ARGS)
execute_process(COMMAND "${EDITOR}" --scene "${WORK_DIR}/${SCENE}" ${ARGS} --save-scene "${WORK_DIR}/out.scene"
                WORKING_DIRECTORY "${WORK_DIR}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE output)
message("${output}")
if(EXPECT_FAIL) # a refused step: exit 1, nothing saved
  if(NOT result EQUAL 1 OR EXISTS "${WORK_DIR}/out.scene" OR NOT output MATCHES "can't contain itself")
    message(FATAL_ERROR "Expected the editor to refuse the step (exit 1, \"can't contain itself\"), got ${result}")
  endif()
  message(STATUS "OK: refused")
  return()
endif()
if(NOT result EQUAL 0)
  message(FATAL_ERROR "kast_editor exited with ${result}")
endif()

function(read_compact file out)
  if(NOT EXISTS "${WORK_DIR}/${file}")
    message(FATAL_ERROR "${file} was not written")
  endif()
  file(READ "${WORK_DIR}/${file}" text)
  string(REGEX REPLACE "[ \t\r\n]+" "" text "${text}")
  set(${out} "${text}" PARENT_SCOPE)
endfunction()
foreach(check IN LISTS EXPECT FORBID)
  string(FIND "${check}" "|" bar)
  string(SUBSTRING "${check}" 0 ${bar} file)
  math(EXPR start "${bar} + 1")
  string(SUBSTRING "${check}" ${start} -1 regex)
  read_compact("${file}" text)
  list(FIND EXPECT "${check}" expected)
  if(expected GREATER -1 AND NOT text MATCHES "${regex}")
    message(FATAL_ERROR "${file} does not match '${regex}'")
  elseif(expected EQUAL -1 AND text MATCHES "${regex}")
    message(FATAL_ERROR "${file} matches the forbidden '${regex}': '${CMAKE_MATCH_0}'")
  endif()
endforeach()

if(DEFINED LAST_Y OR DEFINED LAST_FAR)
  file(READ "${WORK_DIR}/out.scene" scene)
  string(JSON count LENGTH "${scene}" entities)
  set(last "")
  foreach(i RANGE 0 ${count})
    if(i LESS count)
      string(JSON parent TYPE "${scene}" entities ${i} parent)
      string(JSON prefab ERROR_VARIABLE none GET "${scene}" entities ${i} prefab)
      if(parent STREQUAL "NULL" AND NOT none)
        set(last ${i})
      endif()
    endif()
  endforeach()
  foreach(axis 0 1 2)
    string(JSON p${axis} GET "${scene}" entities ${last} instance 0 components Transform position ${axis})
  endforeach()
  message(STATUS "Last root instance at ${p0}, ${p1}, ${p2}")
  if(LAST_Y STREQUAL "zero" AND NOT p1 EQUAL 0)
    message(FATAL_ERROR "Expected y = 0, got ${p1}")
  elseif(LAST_Y MATCHES "^above:(.*)" AND NOT p1 GREATER CMAKE_MATCH_1)
    message(FATAL_ERROR "Expected y above ${CMAKE_MATCH_1}, got ${p1}")
  endif()
  if(DEFINED LAST_FAR AND NOT (p0 GREATER LAST_FAR OR p0 LESS -${LAST_FAR} OR p2 GREATER LAST_FAR OR p2 LESS -${LAST_FAR}))
    message(FATAL_ERROR "Expected x or z beyond ${LAST_FAR} m, got ${p0}, ${p2}")
  endif()
endif()
message(STATUS "OK: ${ARGS}")
