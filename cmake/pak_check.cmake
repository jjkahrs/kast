# Checks a built game.pak's entries: every path in MUST_CONTAIN (a list) is there, and no path matches FORBID_REGEX.
# Reads the pak's table of contents ("KPAK", u32 version, u32 count, then per entry: u32 name length, name, u64 offset,
# u64 size; little-endian, engine/pak.h) and prints it.
# Usage: cmake -DPAK=<game.pak> [-DMUST_CONTAIN=<path;path...>] [-DFORBID_REGEX=<regex>] -P pak_check.cmake
function(read_u32 offset out)
  file(READ "${PAK}" hex OFFSET ${offset} LIMIT 4 HEX)
  string(SUBSTRING "${hex}" 6 2 b3)
  string(SUBSTRING "${hex}" 4 2 b2)
  string(SUBSTRING "${hex}" 2 2 b1)
  string(SUBSTRING "${hex}" 0 2 b0)
  math(EXPR value "0x${b3}${b2}${b1}${b0}")
  set(${out} ${value} PARENT_SCOPE)
endfunction()

file(READ "${PAK}" magic LIMIT 4)
if(NOT magic STREQUAL "KPAK")
  message(FATAL_ERROR "${PAK} is not a Kast pak")
endif()
read_u32(8 count)
set(at 12)
set(entries "")
set(forbidden "")
foreach(i RANGE 1 ${count})
  read_u32(${at} length)
  math(EXPR at "${at} + 4")
  file(READ "${PAK}" name OFFSET ${at} LIMIT ${length})
  string(STRIP "${name}" name) # file(READ ... LIMIT) may add a newline
  math(EXPR at "${at} + ${length} + 16")
  message("  ${name}")
  list(APPEND entries "${name}")
  if(DEFINED FORBID_REGEX AND name MATCHES "${FORBID_REGEX}")
    list(APPEND forbidden "${name}")
  endif()
endforeach()
if(forbidden)
  message(FATAL_ERROR "game.pak holds entries matching '${FORBID_REGEX}': ${forbidden}")
endif()
foreach(path IN LISTS MUST_CONTAIN)
  if(NOT path IN_LIST entries)
    message(FATAL_ERROR "game.pak has no '${path}' entry")
  endif()
endforeach()
message(STATUS "OK: ${count} entries, none matching '${FORBID_REGEX}', all of: ${MUST_CONTAIN}")
