{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "environment": {
        "VCPKG_VISUAL_STUDIO_PATH": "C:/Program Files/Microsoft Visual Studio/2022/Community"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    { "name": "debug", "inherits": "base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "release", "inherits": "base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
    { "name": "relwithdebinfo", "inherits": "base", "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" } }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "relwithdebinfo", "configurePreset": "relwithdebinfo" }
  ],
  "testPresets": [
    { "name": "no-perf", "hidden": true, "output": { "outputOnFailure": true }, "filter": { "exclude": { "label": "perf" } } },
    { "name": "debug", "inherits": "no-perf", "configurePreset": "debug" },
    { "name": "release", "inherits": "no-perf", "configurePreset": "release" },
    { "name": "relwithdebinfo", "inherits": "no-perf", "configurePreset": "relwithdebinfo" },
    { "name": "perf", "configurePreset": "debug", "output": { "outputOnFailure": true }, "filter": { "include": { "label": "perf" } } },
    { "name": "perf-release", "configurePreset": "release", "output": { "outputOnFailure": true }, "filter": { "include": { "label": "perf" } } }
  ]
}
